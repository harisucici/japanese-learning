# --- Turso remote database ---
# Prisma schema generation uses SQLite syntax; runtime requests use Turso.
DATABASE_URL="file:./dev.db"
TURSO_URL="libsql://your-database.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# --- Cloudflare R2 ---
# R2 Account ID (Cloudflare dashboard > Account Home)
R2_ACCOUNT_ID="your-account-id-here"
# R2 Bucket 名称
R2_BUCKET_NAME="ja-learning-audio"
# R2 API 凭证 (Cloudflare dashboard > R2 > Manage R2 API Tokens)
R2_ACCESS_KEY_ID="your-access-key-id-here"
R2_SECRET_ACCESS_KEY="your-secret-access-key-here"
# R2 公开访问端点 (R2 bucket > Settings > Public access > R2.dev subdomain)
# 示例: https://<bucket>.<account>.r2.dev
R2_PUBLIC_URL="https://ja-learning-audio.your-account.r2.dev"

# --- JWT ---
JWT_SECRET="change-me-to-a-random-string"

# --- 服务端口 ---
PORT=3000
