          { "optionId": "opt2", "isCorrect": false, "reason": "「ます」是动词的礼貌体词尾，不能接在名词后" },
          { "optionId": "opt3", "isCorrect": false, "reason": "「だ」是普通体，在礼貌场合不使用" },
          { "optionId": "opt4", "isCorrect": false, "reason": "「である」是书面语的断定，口语中不使用" }
