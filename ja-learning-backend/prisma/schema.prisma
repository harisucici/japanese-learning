generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite does not support enums; use String with validated values in application code
// JLPTLevel: ungraded | n5 | n4 | n3 | n2 | n1
// QuestionType: vocabulary | kanji | grammar | reading | listening | fillInBlank | comprehensive
// QuestionSource: official | mock | textbook | userGenerated | aiGenerated | pastExam | custom
// ExamRecordType: practice | exam | review
// ReviewStatus: new_ | learning | reviewing | mastered

// Opaque identity only. Personal accounts live in a separate Turso database.
model AnonymousLearner {
  id            String    @id @default(uuid())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  learningSessions LearningSession[]
  examRecords   ExamRecord[]
  reviewItems   ReviewItem[]
}

model Question {
  id              String         @id @default(uuid())
  level           String                              // JLPTLevel
  type            String                              // QuestionType
  content         String
  contentReading  String?        // 题干读音（假名）
  options         Json           // [{id, content, hint?, reading?, index}]
  answer          String         // 正确选项的 optionId
  source          String         @default("official") // QuestionSource
  provenance      Json?          // 官方原卷、页码、题号、答案及文件校验值
  explanationId   String         // 关联解析 ID（与前端 Question.explanationId 一致）
  tags            Json           @default("[]")       // String[] as JSON array
  difficulty      Float          @default(0.5)
  order           Int            @default(0)  // 题目顺序
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  learningAnswers LearningAnswer[]
  reviewItems     ReviewItem[]
}

model Explanation {
  id                String   @id @default(uuid())
  questionId        String   @unique // 关联的题目 ID（与前端 Explanation.questionId 一致）
  translation       String
  wordAnalysis      Json     @default("[]")   // [{word, reading, partOfSpeech, meaning, level?, exampleSentence?, exampleTranslation?}]
  sentenceStructure String   @default("")
  grammar           Json     @default("[]")   // [{name, connection, meaning, usage, similarGrammars, exampleSentence?, exampleTranslation?}]
  optionAnalysis    Json     @default("[]")   // [{optionId, isCorrect, reason, detail?, pitfall?}]
  extensions        Json     @default("[]")   // [{id, type, content, options, answer, explanation?, relatedTags}]
  note              String?                  // 学习重点 / 备注
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ExamRecord {
  id              String          @id @default(uuid())
  userId          String
  level           String                              // JLPTLevel
  recordType      String                              // ExamRecordType
  questionIds     Json                                // String[] as JSON array
  answers         Json            // [{questionId, selectedOptionId, isCorrect}]
  score           Int             @default(0)
  totalQuestions  Int
  correctCount    Int             @default(0)
  durationMs      Int
  completedAt     DateTime        @default(now())
  createdAt       DateTime        @default(now())

  user            AnonymousLearner @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ReviewItem {
  id              String        @id @default(uuid())
  userId          String
  questionId      String
  level           String                            // JLPTLevel
  type            String                            // QuestionType
  status          String        @default("new_")     // ReviewStatus
  reviewCount     Int           @default(0)
  nextReviewAt    DateTime?
  easeFactor      Float         @default(2.5)
  intervalDays    Int           @default(0)
  isFavorite      Boolean       @default(false)
  isWrongAnswer   Boolean       @default(false)
  wrongCount      Int           @default(0)
  correctStreak   Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            AnonymousLearner @relation(fields: [userId], references: [id], onDelete: Cascade)
  question        Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId, nextReviewAt])
}

// Database-backed practice: one immutable first answer per question and session.
model LearningSession {
  id             String @id @default(uuid())
  userId         String
  level          String                            // JLPTLevel
  mode           String @default("practice")
  examConfig     Json?
  collectionId   String?
  questionIds    Json                              // String[] as JSON array
  currentIndex   Int @default(0)
  awaitingNext   Boolean @default(false)
  completedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           AnonymousLearner @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers        LearningAnswer[]
  @@index([userId, createdAt])
}

model LearningAnswer {
  id               String @id @default(uuid())
  sessionId        String
  questionId       String
  selectedOptionId String
  isCorrect        Boolean
  answeredAt       DateTime @default(now())
  session          LearningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question         Question @relation(fields: [questionId], references: [id], onDelete: Restrict)
  @@unique([sessionId, questionId])
  @@index([sessionId])
}

model ExamPaper {
 id String @id
 title String
 level String                            // JLPTLevel
 kind String
 examYear Int?
 examMonth Int?
 ready Boolean @default(false)
 sections Json
 materials Json
 verificationNote String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}

model StudyMaterial {
 audioLinks ArticleAudio[]
 id String @id
 title String
 collection String
 japanese String?
 translation String?
 textStatus String
 metadata Json
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}

// Maps an article to an external audio object ID; no media metadata or URL is stored.
model ArticleAudio {
 materialId String
 audioId String
 position Int @default(0)
 material StudyMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
 @@id([materialId, audioId])
 @@unique([audioId])
}

model FunPaper {
 id String @id
 title String
 description String
 theme String
 questionIds Json                          // String[] as JSON array
 materialIds Json                          // String[] as JSON array
 published Boolean @default(false)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}

// Reading content is hosted in Turso independently of practice paper relations.
model ReadingArticle {
 id String @id
 title String
 category String
 position Int
 startPage Int
 endPage Int
 pages Json
 vocabulary Json
 note String
 materialId String
 paperId String
 questionCount Int @default(0)
 published Boolean @default(false)
 sourceTitle String?
 sourcePages Int @default(0)
 attribution String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([position])
}
